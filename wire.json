    "step": "tools/list",
    "request": {
      "jsonrpc": "2.0",
      "method": "tools/list",
      "params": {}
    },
    "response": {
      "jsonrpc": "2.0",
      "result": {
        "tools": [
          {
            "name": "lookup_ticket_history",
            "description": "Look up the full lifecycle history of a support ticket by ticket_id\n    (format: Tnnn, e.g. T002, T008).\n\n    Returns the creation timestamp, status change timeline, and\n    list of assigned agents. If the ticket has no recorded history,\n    returns a clear message so you can tell the user rather than\n    retrying the same call.\n    ",
            "inputSchema": {
              "properties": {
                "ticket_id": {
                  "title": "Ticket Id",
                  "type": "string"
                }
              },
              "required": [
                "ticket_id"
              ],
              "type": "object",
              "title": "lookup_ticket_historyArguments"
            }
          },
          {
            "name": "get_escalation_history",
            "description": "Get the escalation chain for a support ticket by ticket_id\n    (format: Tnnn, e.g. T003, T008).\n\n    Returns a list of escalation events with timestamps, the agents\n    involved, the reason for escalation, and the escalation level.\n    If no escalations exist for this ticket, returns an empty list\n    with a note that the ticket was never escalated.\n    ",
            "inputSchema": {
              "properties": {
                "ticket_id": {
                  "title": "Ticket Id",
                  "type": "string"
                }
              },
              "required": [
                "ticket_id"
              ],
              "type": "object",
              "title": "get_escalation_historyArguments"
            }
          }
        ]
      }
    }
  },
