  {
    "server": "billing-tools",
    "step": "tools/list",
    "request": {
      "jsonrpc": "2.0",
      "method": "tools/list",
      "params": {}
    },
    "response": {
      "jsonrpc": "2.0",
      "result": {
        "tools": [
          {
            "name": "get_ticket",
            "description": "Look up a support ticket by ticket_id (format: Tnnn, e.g. T002, T008).\n\n    Returns the ticket text, customer_id, and linked order_id.\n    If the ticket is not found, returns a message with the expected ID format\n    so you can ask the user to double-check rather than retrying the same call.\n    ",
            "inputSchema": {
              "properties": {
                "ticket_id": {
                  "title": "Ticket Id",
                  "type": "string"
                }
              },
              "required": [
                "ticket_id"
              ],
              "type": "object",
              "title": "get_ticketArguments"
            }
          },
          {
            "name": "get_order",
            "description": "Fetch an order record by order ID (format: Onnn, e.g. O201, O210).\n\n    Returns purchase date, amount, currency, fulfilment status,\n    and days_since_purchase. If not found, returns a not_found message\n    with the expected format so you can ask the user to verify.\n    ",
            "inputSchema": {
              "properties": {
                "order_id": {
                  "title": "Order Id",
                  "type": "string"
                }
              },
              "required": [
                "order_id"
              ],
              "type": "object",
              "title": "get_orderArguments"
            }
          },
          {
            "name": "get_customer_tier",
            "description": "Return the SLA tier for a customer account (format: Cnnn, e.g. C101).\n\n    Used to select the applicable refund window. The tier parameter is a\n    caller hint only; the record's actual tier is always authoritative.\n    If not found, returns a not_found message with the expected format.\n    ",
            "inputSchema": {
              "properties": {
                "customer_id": {
                  "title": "Customer Id",
                  "type": "string"
                },
                "tier": {
                  "default": "standard",
                  "title": "Tier",
                  "type": "string"
                }
              },
              "required": [
                "customer_id"
              ],
              "type": "object",
              "title": "get_customer_tierArguments"
            }
          },
          {
            "name": "search_knowledge_base",
            "description": "Search the billing support knowledge base using hybrid retrieval\n    (BM25 + dense vector RRF fusion).\n\n    Use this to look up billing policies, error code explanations,\n    migration procedures, account roles, or any question that requires\n    documented knowledge rather than live order/ticket data.\n\n    query: a natural-language search string.\n    top_k: number of results to return (1-5, default 3).\n    ",
            "inputSchema": {
              "properties": {
                "query": {
                  "title": "Query",
                  "type": "string"
                },
                "top_k": {
                  "default": 3,
                  "title": "Top K",
                  "type": "integer"
                }
              },
              "required": [
                "query"
              ],
              "type": "object",
              "title": "search_knowledge_baseArguments"
            }
          }
        ]
      }
    }
  },
