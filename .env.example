# Provider: "groq" or "ollama"
LLM_PROVIDER=groq

# Groq settings (used when LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.1-8b-instant

# Ollama settings (used when LLM_PROVIDER=ollama)
# LLM_MODEL=llama3.2:latest
# OLLAMA_BASE_URL=http://localhost:11434

# LangFuse observability (optional -- leave blank to disable)
LANGFUSE_PUBLIC_KEY=your_public_key_here
LANGFUSE_SECRET_KEY=your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# Auth -- Google OAuth + JWT
# 1. Go to console.cloud.google.com > APIs & Services > Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add http://localhost:4200 to Authorized JavaScript origins
# 4. Copy the Client ID here AND into frontend/src/app/components/login/login.component.ts
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_secret
# Required: the email address that gets admin access on first login
ADMIN_EMAIL=your_admin_email@example.com

# Email alerts for critical traces (background thread, rate limited to 1 per type per 5 min).
# Gmail: enable 2FA, then create an App Password. Never commit the real values.
ALERT_EMAIL_ENABLED=false
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_PASSWORD=
ALERT_COST_THRESHOLD=0.001
ALERT_LATENCY_THRESHOLD_MS=10000

# Observability page (admin only).
# Demo tools show a "Plant a bad answer" button for practising the support drill. Keep false in production.
OBS_DEMO_TOOLS=false
# Provider rate limits used by the "What breaks first at 10x?" calculator (0 disables a limit).
OBS_LIMIT_TPM=8000
OBS_LIMIT_RPD=1000
OBS_LIMIT_RPM=0

# Base URL of the web app. The "Open this trace" button in alert emails links here.
ALERT_APP_URL=http://localhost:4200


# Max thumbs-down emails sent to the admin per hour (the vote is always saved).
FEEDBACK_EMAIL_MAX_PER_HOUR=20

# Traces live only in Langfuse. These tune how the Observability page reads them.
# The plan tested allows 5 list calls per minute, so the defaults are conservative.
LANGFUSE_API_MAX_PER_MIN=5
LANGFUSE_CACHE_SECONDS=60
LANGFUSE_SCAN_LIMIT=200
# Also write traces to evaluation/traces.jsonl so the old Week 6 pages keep working.
TRACE_JSONL_MIRROR=false

# development (default) or production. In production the API refuses to start with unsafe settings
# (example secrets, LLM_CACHE not off, TIER1_DEMO_CUSTOMER_ID set). Check readiness at GET /api/ready.
APP_ENV=development

# --- Week 12: Tier-1 Deflection Assistant -------------------------------------------------------
# Agent model. The code default is openai/gpt-oss-120b; set another only if your key can reach it,
# for example openai/gpt-oss-120b. List what your key can use with: GET https://api.groq.com/openai/v1/models
# LLM_MODEL=openai/gpt-oss-120b
# Judge for the eval suite. Keep it a DIFFERENT model family from the agent (self-grading bias).
JUDGE_MODEL=qwen/qwen3.8-27b
# LLM response cache: readwrite (default, development), off (production: keeps no prompts on disk), replay (CI: no network).
LLM_CACHE=readwrite
# Tokens per minute the gateway paces itself to. Read the real limit from the x-ratelimit-limit-tokens response header.
LLM_TPM=8000
# Salt for the hashed customer and order ids that appear in logs and traces. Set a long random value in production.
PII_HASH_SALT=change-me
# Where the Tier-1 runtime database lives (default data/tier1.db). The reference date for "days since purchase" travels
# with the synthetic data; set TIER1_AS_OF=YYYY-MM-DD only to override it.
# TIER1_DB_PATH=
# Where the catalog lives (reference lists, settings, model prices, versioned prompts and guard rules, eval cases,
# runs and labels, change log). Default data/catalog.db; created from data/seed/ on first start, edited on the Data page.
# CATALOG_DB_PATH=
# TIER1_AS_OF=
# Demo only: the customer a non-admin user acts as when no customer email matches their sign-in. Unset in production.
# TIER1_DEMO_CUSTOMER_ID=
# Test seam for before/after measurement ONLY (version_filter, policy_guard). Never set in production.
# TIER1_ABLATE=

# Accounts
# Leave GOOGLE_CLIENT_ID empty to use email + password sign-in only.
PASSWORD_AUTH_ENABLED=true
# Comma-separated browser origins allowed to call the API (default http://localhost:4200)
# ALLOWED_ORIGINS=http://localhost:4200

# Bearer token for serving the help-centre MCP server over HTTP (make mcp-http). 16+ random characters.
# Give it only to the reviewer who connects; never commit it.
MCP_HTTP_TOKEN=
