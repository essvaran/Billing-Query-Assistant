# Provider: "groq" or "ollama"
LLM_PROVIDER=groq

# Groq settings (used when LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.1-8b-instant

# Ollama settings (used when LLM_PROVIDER=ollama)
# LLM_MODEL=llama3.2:latest
# OLLAMA_BASE_URL=http://localhost:11434

# LangFuse observability (optional — leave blank to disable)
LANGFUSE_PUBLIC_KEY=your_public_key_here
LANGFUSE_SECRET_KEY=your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# Auth — Google OAuth + JWT
# 1. Go to console.cloud.google.com > APIs & Services > Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add http://localhost:4200 to Authorized JavaScript origins
# 4. Copy the Client ID here AND into frontend/src/app/components/login/login.component.ts
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_secret
# Required: the email address that gets admin access on first login
ADMIN_EMAIL=your_admin_email@example.com

# Email alerts for critical traces (background thread, rate limited to 1 per type per 5 min).
# Gmail: enable 2FA, then create an App Password. Never commit the real values.
ALERT_EMAIL_ENABLED=false
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_PASSWORD=
ALERT_COST_THRESHOLD=0.001
ALERT_LATENCY_THRESHOLD_MS=10000

# Observability page (admin only).
# Demo tools show a "Plant a bad answer" button for practising the support drill. Keep false in production.
OBS_DEMO_TOOLS=false
# Provider rate limits used by the "What breaks first at 10x?" calculator (0 disables a limit).
OBS_LIMIT_TPM=8000
OBS_LIMIT_RPD=1000
OBS_LIMIT_RPM=0

# Base URL of the web app. The "Open this trace" button in alert emails links here.
ALERT_APP_URL=http://localhost:4200


# Max thumbs-down emails sent to the admin per hour (the vote is always saved).
FEEDBACK_EMAIL_MAX_PER_HOUR=20

# Traces live only in Langfuse. These tune how the Observability page reads them.
# The plan tested allows 5 list calls per minute, so the defaults are conservative.
LANGFUSE_API_MAX_PER_MIN=5
LANGFUSE_CACHE_SECONDS=60
LANGFUSE_SCAN_LIMIT=200
# Also write traces to evaluation/traces.jsonl so the old Week 6 pages keep working.
TRACE_JSONL_MIRROR=false
